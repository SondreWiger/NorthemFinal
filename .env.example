# Copy to apps/<app>/.env.local for local dev, and add the same keys in Vercel.
# Never commit real values.

# Supabase (one project for every app)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: forms, invites, admin actions

# Which org this deployment serves when a host isn't in org_domains
ORG_SLUG=northem

# Domains
NEXT_PUBLIC_ROOT_DOMAIN=northem.group
NEXT_PUBLIC_PORTAL_URL=https://portal.northem.group
NEXT_PUBLIC_ADMIN_URL=https://admin.northem.group
NEXT_PUBLIC_SITE_URL=https://northem.group
COOKIE_DOMAIN=.northem.group        # shares the sign-in between portal and admin; leave empty on localhost

# Mail (Resend)
RESEND_API_KEY=
MAIL_FROM=Northem <hello@northem.group>
MAIL_INBOX=hello@northem.group      # where new form submissions are announced

# Integrations
CONNECTIONS_ENC_KEY=                # 32 random bytes, base64: openssl rand -base64 32
SPS_BASE_URL=https://screenplaystudio.fun
GRAPHITE_BASE_URL=https://graphite.cinderra.fun
